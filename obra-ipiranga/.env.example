# =============================================================================
# Obra Ipiranga — Variáveis de ambiente
# =============================================================================
# 1. cp .env.example .env
# 2. Preencha os valores (NUNCA commite o .env)
# 3. docker compose up -d --build
# =============================================================================


# -----------------------------------------------------------------------------
# LOGIN INICIAL (após o seed)
# -----------------------------------------------------------------------------
# E-mail e senha do primeiro administrador.
SEED_ADMIN_EMAIL=admin@obraipiranga.com
SEED_ADMIN_PASSWORD=Admin@123TroqueEmProducao

# Gerar senha forte:  openssl rand -base64 16


# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=obra
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=obra_ipiranga

# Host interno Docker = nome do serviço "postgres"
# Escreva valores LITERAIS (não use $POSTGRES_USER dentro da string no .env)
DATABASE_URL=postgresql://obra:troque_esta_senha_forte@postgres:5432/obra_ipiranga?schema=public

# Gerar senha:  openssl rand -base64 24


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Segredo para assinar tokens. Se vazar, forjam login de admin.
JWT_SECRET=troque_por_segredo_longo
JWT_EXPIRES_IN=7d

# Gerar no Linux:
#   openssl rand -base64 32
#   openssl rand -hex 64


# -----------------------------------------------------------------------------
# PORTAS E URL DA API
# -----------------------------------------------------------------------------
# API_PORT = porta no HOST (browser → localhost:3001)
# Dentro do container a API escuta sempre na 3000.
API_PORT=3001
WEB_PORT=3000

# URL que o BROWSER usa. Valor LITERAL (não use ${API_PORT}).
# O Next.js embute isso no build — precisa estar correto no momento do build.
NEXT_PUBLIC_API_URL=http://localhost:3001

NODE_ENV=production


# -----------------------------------------------------------------------------
# GOOGLE SHEETS (opcional)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=CONTROLE NF!A1:Z


# -----------------------------------------------------------------------------
# EVOLUTION API (opcional)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=obra-ipiranga
