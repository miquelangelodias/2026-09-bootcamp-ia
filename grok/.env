# .env.example
# ==========================================
# 1. CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRES)
# ==========================================
# Banco de Dados (Prisma)
POSTGRES_USER="obra"
POSTGRES_PASSWORD="Sfasldfscae3lasd3"
POSTGRES_DB="obra_ipiranga"

# A URL do Prisma usa o nome do serviço do docker-compose ("db") em vez de "localhost"
DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB?schema=public"

# ==========================================
# 2. CONFIGURAÇÕES DA API (NODE.JS / NEXT / EXPRESS)
# ==========================================
# -----------------------------------------------------------------------------
# Autenticação (JWT)
# Utilidade: Esta variável é o segredo criptográfico usado pelo servidor para 
# assinar e validar os tokens JWT (JSON Web Tokens) de acesso dos usuários. 
# Se essa chave for vazada, invasores poderão forjar tokens de administrador.
#
# COMO GERAR UMA CHAVE SEGURA NO TERMINAL LINUX:
# Execute o seguinte comando no terminal:
# openssl rand -base64 32
# openssl rand -base64 24
# -----------------------------------------------------------------------------
JWT_SECRET="nsufa0G04SX5v+C2FwNWen7qdsLW87WQ9XjXPER1G+E="

# Configurações da API
API_PORT=3001

# ==========================================
# 3. CONFIGURAÇÕES DO FRONTEND (NEXT.JS)
# ==========================================
WEB_PORT=3000
# Configurações do Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"

NODE_ENV=production
# ==========================================
# 4. CREDENCIAIS INICIAIS (SEED DO BANCO)
# ==========================================
# Variáveis consumidas pelo api/prisma/seed.ts para criar o primeiro usuário
SEED_ADMIN_EMAIL=admin@obraipiranga.com
SEED_ADMIN_PASSWORD="IjLkpMkm6gaANtvcj7egIfczbfJcPsCC"


# -----------------------------------------------------------------------------
# GOOGLE SHEETS (opcional)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=CONTROLE NF!A1:Z


# -----------------------------------------------------------------------------
# EVOLUTION API (opcional)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=obra-ipiranga